[alias]
    l = "!bash -c 'source ~/.githelpers && pretty_git_log'"
    st = status
    ci = commit
    co = checkout
    di = diff
    dc = diff --cached
    aa = add --all
    pullff = pull --ff-only
[core]
    excludesfile = ~/.gitignore_global
    editor = nvim
[init]
    defaultBranch = main
[http]
    postBuffer = 524288000

# Name, email, credential helpers and anything machine-specific.
# Kept last so it wins over the settings above.
[include]
    path = ~/.gitconfig.local
